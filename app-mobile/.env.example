# Copy to .env.local and fill in values. Never commit real values.
#
# Only EXPO_PUBLIC_* variables are bundled into the client and are therefore
# PUBLIC. Put ONLY the Supabase project URL and the anon (publishable) key here.
#
# NEVER add the Supabase service-role key, JWT secret, database password,
# or push-provider server credentials to this app. Those belong only in
# Supabase Edge Function secrets / server-side environments.

EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
